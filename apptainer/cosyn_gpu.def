Bootstrap: docker
From: docker.m.daocloud.io/nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%files
    cache/gpu/libtorch /opt/libtorch
    cache/src /opt/cosyn-src

%post
    export DEBIAN_FRONTEND=noninteractive

    # Use Tsinghua APT mirror for faster builds in mainland China.
    # NVIDIA container images already ship with ca-certificates, so HTTPS is fine.
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then
        sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources || true
        sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources || true
    else
        sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list || true
        sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list || true
    fi

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential g++ curl ca-certificates unzip libgomp1

    # NCCL is already included in the nvidia/cuda:11.8.0-cudnn8-devel base image,
    # so no extra installation is needed here.

    # Install Rust. Use Tsinghua mirror for toolchain downloads; rustup-init
    # script itself is fetched from the official source (ca-certificates is
    # already installed at this point).
    export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
    . "$HOME/.cargo/env"

    cd /opt/cosyn-src
    export LIBTORCH=/opt/libtorch
    export PATH="/root/.cargo/bin:${PATH}"

    # Build GPU-enabled cosyn (Makefile auto-detects libtorch_cuda.so and defines USE_CUDA).
    make release

    mkdir -p /opt/cosyn/bin
    cp target/release/cosyn /opt/cosyn/bin/cosyn

    # Cleanup to reduce image size.
    rm -rf target
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LIBTORCH=/opt/libtorch
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/cosyn/bin:/usr/local/cuda/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/libtorch/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

%runscript
    exec cosyn "$@"
